# UPIGuard backend configuration.
# Copy to backend/.env and fill in the Supabase values.

PORT=3001
NODE_ENV=development

# Supabase (REQUIRED — the app's only data layer)
# Supabase Dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=   # server-only — NEVER expose to the frontend

# Comma-separated list of allowed browser origins (production).
# Leave unset for dev; unset = reflect any origin (fine for the demo).
CORS_ORIGIN=

# SAFETY VALVE: POST /api/reset wipes and reseeds the database. It stays
# disabled (403) unless this is explicitly 'true'. Enable locally for demos.
RESET_ALLOW_UNSAFE=false
